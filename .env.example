# Copy to .env. Without an API key, HireFlow uses the offline heuristic scorer.
DATABASE_URL=postgres://hireflow:hireflow@localhost:5432/hireflow
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3000
WORKER_CONCURRENCY=4
OUTBOX_RELAY_INTERVAL_MS=1000
QUEUE_PREFIX=hireflow
# Mark scoring as failed if it makes no progress for this long (API watchdog)
SCORING_STALE_MINUTES=15
SCORING_WATCHDOG_INTERVAL_MS=60000

# LLM_PROVIDER=anthropic | openai | heuristic
# heuristic = demo mode (keyword matching, no AI). Choosing anthropic/openai without its key is an error.
LLM_PROVIDER=heuristic
# Optional: override the default model for the chosen provider
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Authentication ---
# Required: a random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
# (start-hireflow.cmd generates one for you automatically.)
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Set to false to stop new teams signing up (existing admins can still add members)
ALLOW_SIGNUP=true
# Login/sign-up attempts per minute per IP
AUTH_RATE_LIMIT=10
