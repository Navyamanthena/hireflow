{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../../..",
  "testEnvironment": "node",
  "testRegex": "apps/api/test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
  },
  "testTimeout": 30000,
  "setupFiles": [
    "<rootDir>/apps/api/test/setup-env.ts"
  ]
}